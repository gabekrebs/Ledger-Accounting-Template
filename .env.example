# ─────────────────────────────────────────────────────────────────────────────
# Ledger Accounting Template — environment variables
#
# Copy this file to `.env.local` for local development and fill in real values.
# `.env.local` is git-ignored — NEVER commit real secrets.
# In production, set these in your Vercel project (Vercel does NOT read .env.local).
# NEXT_PUBLIC_* values are exposed to the browser; everything else is server-only.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (Postgres + Auth + Storage) ────────────────────────────────────
# Create a project at https://supabase.com. Find these under Project Settings.
SUPABASE_DB_URL=postgres://postgres:PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Plaid (bank feed) ────────────────────────────────────────────────────────
# Create an app at https://dashboard.plaid.com. Start in "sandbox".
PLAID_CLIENT_ID=your-plaid-client-id
PLAID_SECRET=your-plaid-secret
PLAID_ENV=sandbox
# 32-byte base64 key that AES-256-GCM-encrypts stored Plaid access tokens.
# Generate: openssl rand -base64 32   — keep IDENTICAL across environments
# sharing one DB, and never rotate it without re-encrypting stored tokens.
PLAID_TOKEN_KEY=generate-with-openssl-rand-base64-32
# OAuth redirect (required for OAuth banks). Must EXACTLY match an "Allowed
# redirect URI" registered in the Plaid dashboard. Leave blank for local dev.
PLAID_REDIRECT_URI=https://your-app.example.com/ledger/connections
# Public HTTPS base the Plaid webhook posts to. Blank locally = link without a webhook.
PLAID_WEBHOOK_URL=https://your-app.example.com/api/plaid/webhook

# ── Machine-endpoint secrets (fail-closed: unset/blank rejects everything) ────
# Gates /api/cron/* ONLY (Vercel Cron sends `Authorization: Bearer $CRON_SECRET`).
CRON_SECRET=generate-a-long-random-string
# Gates the Plaid webhook receiver ONLY (token embedded in the per-Item webhook
# URL). Deliberately separate from CRON_SECRET. After changing it, re-register
# existing Items: `node --env-file=.env.local ./node_modules/.bin/tsx scripts/update-plaid-webhooks.mts`
PLAID_WEBHOOK_SECRET=generate-a-different-long-random-string

# ── Auth (email + password, admin-provisioned; no self-signup) ───────────────
# Comma-separated. ALLOWED = who may sign in; ADMIN = who sees every entity.
AUTH_ALLOWED_EMAILS=you@example.com,teammate@example.com
AUTH_ADMIN_EMAILS=you@example.com
# The single account permitted to CREATE entities (identity check, not a role).
# If unset, entity creation is closed to everyone.
OWNER_EMAIL=you@example.com

# Optional: the partner name used by the "Owner" pro-rata ownership view
# on the portfolio comparison screen. Unset = that view shows dashes.
OWNER_NAME=

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Optional integrations ────────────────────────────────────────────────────
# Anthropic — powers AI category *suggestions* + AI property valuation.
# The app runs without it (rules/recognizers still auto-post); suggestions just
# won't appear. https://console.anthropic.com
ANTHROPIC_API_KEY=

# RentCast — optional automated property-value estimates on the Valuation tab.
# https://www.rentcast.io
RENTCAST_API_KEY=

# ── Tests only ───────────────────────────────────────────────────────────────
# A DISPOSABLE Postgres URL for DB-backed tests (never your production DB).
# Leave unset and those tests skip themselves.
TEST_DATABASE_URL=
