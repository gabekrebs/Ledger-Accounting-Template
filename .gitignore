# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit real secrets; the placeholder template IS committed
.env*
!.env.example

# vercel
.vercel

# local AI-assistant / tooling artifacts
.agents/
skills-lock.json

# typescript
*.tsbuildinfo
next-env.d.ts

# gstack (local security reports, analytics)
.gstack/
